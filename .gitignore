# Médias de production : trop lourds pour l'historique git.
# Le film et la couverture sont servis depuis CloudFront et seront
# déplacés vers Supabase Storage.
outputs/*.mp4
outputs/*.png
outputs/*.zip

# Rushes de production vidéo : les scènes brutes font 1,5 Mo pièce. Le script
# et le manifeste, eux, sont versionnés — ce sont eux qui permettent de
# refaire le film à l'identique.
work/video-*/scene*.png
work/video-*/.montage/
work/video-*/.apercu/
work/video-*/*.mp3
work/video-*/*.wav
work/video-*/*.mp4

# Secrets / configuration locale
.env
.env.*
!.env.example

# Système
Thumbs.db
desktop.ini
.DS_Store

# Les films vivent dans le stockage Supabase, pas dans le depot.
app/public/films/

# Les images sources de Higgsfield : lourdes, et regenerables depuis les prompts.
work/images-*/
__pycache__/

# Les photos des emplois du temps : la transcription fait foi.
work/emplois/

# Les photos de cahier : la transcription fait foi.
work/cahier-*/
