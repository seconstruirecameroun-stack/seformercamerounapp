  "through_line": "One word describes another, and sometimes it keeps a capital letter.",
  "blocks": [
    {
      "n": 1,
      "vo_line": "An adjective is a word that describes a noun.",
      "scene": {
        "scene": "adjectif",
        "mots": [
          "a",
          "sharp",
          "trowel"
        ],
        "adjectif": 1,
        "note": "sharp describes the trowel"
      },
      "keywords": [
        "ADJECTIVE"
      ],
      "niba": "content"
    },
    {
      "n": 2,
      "vo_line": "Heavier is not a sentence. The hammer is heavy — that is a sentence.",
